# Server Configuration
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# MongoDB Atlas Database
# If left empty, backend falls back gracefully to high-performance in-memory MongoDB
MONGODB_URI=

# Supabase Auth Configuration
# Replace with your Supabase Project Settings -> API credentials
SUPABASE_URL=https://xyzcompany.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.mock_supabase_anon_key_for_development_mode
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.mock_supabase_service_role_key

# Internal Ingestion Secret for CFP Scrapers
INGESTION_API_KEY=researchly-scraper-auth-secret-key-9988

# AI Microservice URL (FastAPI / FAISS)
AI_SERVICE_URL=http://localhost:8000

# Email Engine (Nodemailer / Ethereal / Sendgrid / SMTP)
# Defaults to Ethereal / auto-generated test SMTP if credentials are dummy
EMAIL_HOST=smtp.ethereal.email
EMAIL_PORT=587
EMAIL_USER=researchly.demo@ethereal.email
EMAIL_PASS=ethereal_secret_password
EMAIL_FROM="Researchly AI" <digest@researchly.io>
